# mock: all API requests are handled in the browser
# hybrid: browser mocks handle unfinished modules and proxy implemented modules
# backend: every API request is sent to VITE_API_BASE_URL
VITE_DATA_MODE=mock

# Used in backend mode. Same-origin /api is the production-safe default.
VITE_API_BASE_URL=/api

# Used only in hybrid mode while the demo backend is incomplete.
VITE_SUBMISSIONS_BACKEND_URL=http://localhost:4000
