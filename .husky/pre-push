#!/bin/sh
#
# Pre-push gate.
#
# The organization CI workflow owns typecheck, tests and the production build.
# Keep pushes fast and avoid printing a false local verification result.
#
# If you genuinely need to bypass this (a hotfix on a broken main, say), use
# `git push --no-verify` — and say so in the pull request.

echo "→ pre-push: full verification runs in CI"
