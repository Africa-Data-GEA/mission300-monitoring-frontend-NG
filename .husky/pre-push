#!/bin/sh
#
# Pre-push gate.
#
# Nothing reaches the remote unless it typechecks and lints clean.
#
# If you genuinely need to bypass this (a hotfix on a broken main, say), use
# `git push --no-verify` — and say so in the pull request.

set -e

echo "→ pre-push: typecheck"
pnpm typecheck

echo "→ pre-push: lint"
pnpm lint

echo "✓ pre-push checks passed"
