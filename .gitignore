# Separate git repository, cloned in place for local API work.
# It has its own remote and must never be committed here as a gitlink.
mission300-monitoring-backend-NG/

# Output of the local QA crawls (screenshots and the findings report they
# write). Regenerated by running the qa-*.mjs scripts, so there is nothing
# to gain from versioning ~21MB of PNGs.
qa-screenshots/
qa-findings.json

# Local reference/handoff docs, not part of the app - root-level only, so
# this doesn't catch the real downloadable templates under public/.
/docs/
/tmp/
/*.xlsx
/*.html
!/index.html
/*.zip

# Throwaway root-level QA/verification scripts (qa-*.mjs) - written and run
# ad hoc against a live dev server during a session, not part of the app or
# its test suite. Delete when done rather than committing; if one earns its
# keep, move it into a real test file instead.
/qa-*.mjs
